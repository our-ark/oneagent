oneagent_python_supported() {
  "$1" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1
}

oneagent_find_python() {
  local candidate

  if [[ -n "${ONEAGENT_PYTHON:-}" ]]; then
    if oneagent_python_supported "$ONEAGENT_PYTHON"; then
      printf '%s\n' "$ONEAGENT_PYTHON"
      return 0
    fi

    printf 'oneagent: ONEAGENT_PYTHON points to an unsupported interpreter: %s\n' "$ONEAGENT_PYTHON" >&2
    printf 'oneagent: Python >= 3.11 is required.\n' >&2
    return 1
  fi

  for candidate in python3.13 python3.12 python3.11 python3 python; do
    if command -v "$candidate" >/dev/null 2>&1 && oneagent_python_supported "$candidate"; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  printf 'oneagent: Python >= 3.11 is required.\n' >&2
  printf 'oneagent: Install a supported Python or set ONEAGENT_PYTHON to its executable path.\n' >&2
  return 1
}

oneagent_run_module() {
  local module="$1"
  local python
  shift

  cd "$ONEAGENT_ROOT"
  python="$(oneagent_find_python)" || return 1
  PYTHONPATH="$ONEAGENT_ROOT/src${PYTHONPATH:+:$PYTHONPATH}" "$python" -m "$module" "$@"
}
